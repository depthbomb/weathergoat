{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"env": {
		"builtin": true,
		"node": true
	},
	"globals": {
		"Bun": "readonly"
	},
	"ignorePatterns": [
		"node_modules/**",
		".data/**",
		"src/database/generated/**",
		"src/database/contract/**",
		"**/*.generated.ts"
	]
}
