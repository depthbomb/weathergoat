    attemptCount   Int                                   @default(0)
    nextAttemptAt  DateTime(as: temporal, precision: 3)  @default(now())
    createdAt      DateTime(as: temporal, precision: 3)  @default(now())
    announcement   Announcement                          @relation(fields: [announcementId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "AnnouncementDelivery_announcementId_fkey", index: false)
    subscription   AnnouncementSubscription              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AnnouncementDelivery_subscriptionId_fkey", index: false)

    @@index([announcementId], map: "AnnouncementDelivery_announcementId_idx")
    @@index([announcementId, subscriptionId], map: "AnnouncementDelivery_announcementId_subscriptionId_key", unique: true)
    @@index([sentAt, nextAttemptAt], map: "AnnouncementDelivery_sentAt_nextAttemptAt_idx")
    @@index([subscriptionId], map: "AnnouncementDelivery_subscriptionId_idx")
    @@map("AnnouncementDelivery")
  }

